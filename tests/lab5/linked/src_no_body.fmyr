# with src, the { } can be left out: the element only links a file
div() {
  style(src = "assets/page.css")
  text() { "Hi" }
  script(src = "assets/app.js")
}   # expect: <!DOCTYPE html><html lang="html"><head><style>h1 { color: blue; }</style></head><body><div><h1>Hi</h1></div><script>console.log('linked')</script></body></html>
